# Copy this file to .env and fill in your API keys.
# Keys are optional — any missing source is skipped and DuckDuckGo is used as fallback.

# Google Custom Search (100 free queries/day)
# Get keys at: https://console.developers.google.com
GOOGLE_API_KEY=
GOOGLE_CX=

# SerpAPI (100 free searches/month)
# Sign up at: https://serpapi.com/users/sign_up
SERPAPI_KEY=

# TinEye Reverse Image Search (150 free searches/month)
# Sign up at: https://services.tineye.com/TinEyeAPI
TINEYE_API_KEY=
TINEYE_API_SECRET=

# HaveIBeenPwned email breach check (paid, skippable)
# Get key at: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Skipped services (set to true to disable without deleting key)
SKIP_GOOGLE=false
SKIP_SERPAPI=false
SKIP_TINEYE=false
SKIP_HIBP=false
